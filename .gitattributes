# 行尾统一
#
# 本机 git config core.autocrlf=true，Windows 上全新 clone 的文本文件
# 会被转成 CRLF。**gofmt 在 CRLF 下会把每个 .go 文件都判定为"未格式化"**，
# CI 上 `gofmt -l .` 会输出整个仓库。强制 LF 解决。

* text=auto eol=lf

# Go 源码：必须是 LF，gofmt 要求
*.go    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.sh    text eol=lf

# Windows 脚本保持 CRLF（PowerShell/cmd 惯用）
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
*.exe   binary
*.pem   binary
*.key   binary
